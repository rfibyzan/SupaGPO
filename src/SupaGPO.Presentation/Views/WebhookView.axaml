<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SupaGPO.Presentation.ViewModels"
             x:DataType="vm:WebhookViewModel"
             x:Class="SupaGPO.Presentation.Views.WebhookView">

    <StackPanel Spacing="12">
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Discord Webhooks" Classes="h2" />
                <TextBlock Classes="caps" Text="Event embeds for Fishing Started / Stopped / Catch. URL is user-configured, never stored in repo." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Webhook URL:" Classes="label" />
                    <TextBox Text="{Binding WebhookUrl}" Width="400" />
                </StackPanel>
                <CheckBox Content="Fishing Started" IsChecked="{Binding FishingStarted}" />
                <CheckBox Content="Fishing Stopped" IsChecked="{Binding FishingStopped}" />
                <CheckBox Content="Catch Notify" IsChecked="{Binding CatchNotify}" />
                <Button Content="Test Webhook" Command="{Binding TestCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Status}" Classes="caps" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
